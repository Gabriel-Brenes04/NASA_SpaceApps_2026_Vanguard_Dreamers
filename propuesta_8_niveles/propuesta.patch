+            lado = 1 if a >= 0 else -1
+            _hoja(s, x, y, a * (1 + 0.5 * seco) + sw, l, l * 0.42, _secar(base, seco), a * 0.45 + lado * seco * 1.5)
+        p["frutos"] = [(x, y - largo * 0.5)]
